# Ambiente de execução: development | test | production
# OBRIGATÓRIA. Três controles de segurança dependem deste valor (política de CORS,
# HSTS e bloqueio da sandbox administrativa). Se ficar ausente em produção, os três
# assumem o comportamento permissivo de desenvolvimento.
NODE_ENV="development"

# Database PostgreSQL Connection String (Neon DB recommended)
DATABASE_URL="postgresql://user:password@ep-sample-neon.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Server Port (Default: 3000)
PORT=3000

# Chave de assinatura do JWT. OBRIGATÓRIA em todos os ambientes, mínimo 32 caracteres.
# A aplicação não sobe sem ela e recusa o valor de exemplo abaixo — gere a sua:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# URL canônica do frontend. OBRIGATÓRIA em produção, e deve conter UMA única URL:
# além do CORS, ela monta o link de convite enviado ao paciente.
WEB_ORIGIN="http://localhost:5173"

# Origens ADICIONAIS autorizadas no CORS, separadas por vírgula. Opcional.
# Use para previews sem quebrar o link de convite. Não há coringa de domínio:
# cada origem entra explicitamente (ex: "https://preview-x.vercel.app").
CORS_ORIGINS=""

# ─────────────────────────────────────────────────────────────────────────────
# CRIPTOGRAFIA DE CONTEÚDO CLÍNICO — OBRIGATÓRIA
#
# ⚠️  PERDER ESTA CHAVE TORNA TODO O CONTEÚDO CLÍNICO PERMANENTEMENTE ILEGÍVEL.
#     Não existe recuperação. Guarde-a FORA do painel do Render, em pelo menos
#     dois lugares independentes (gerenciador de senhas + cópia offline), ANTES
#     de colocá-la em produção.
#
# Cifra chat, diário emocional e orientações (LGPD art. 5º, II — dado sensível).
# 32 bytes em base64. Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# Versão da chave ativa. Opcional (padrão 1). Incremente ao rotacionar.
APP_ENCRYPTION_KEY_VERSION="1"

# Chaves aposentadas, para manter registros antigos legíveis após uma rotação.
# Formato: "versao:chaveBase64,versao:chaveBase64". Opcional.
# Rotação = gere chave nova, incremente a versão acima, e mova a anterior para cá.
APP_ENCRYPTION_KEYS_RETIRED=""
# ─────────────────────────────────────────────────────────────────────────────

# Fuso horário do produto, usado para a janela do "dia" da autoavaliação e para
# formatar datas em mensagens. Opcional (padrão: America/Sao_Paulo).
APP_TIMEZONE="America/Sao_Paulo"

# Keep administrative demo data disabled in production unless it is explicitly needed.
ENABLE_SANDBOX_ADMIN="false"

# Required only when running `npm run prisma:seed` to provision the first admin.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"
